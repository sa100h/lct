POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me

# JWT signing material is generated locally and mounted read-only.
JWT_KEYS_PATH=./.keys

# Deploy only: directory on the host mounted at /https in api-proxy.
CERTS_PATH=./certs

# Optional host ports when 80 or 443 are occupied.
# API_PROXY_HTTP_PORT=80
# API_PROXY_HTTPS_PORT=443

# ============================================
# Samba AD DC — переменные окружения
# ============================================

# Полное доменное имя (FQDN). Обязательно!
# Пример: lct.local или corp.example.com
DOMAIN=lct.ru

# Пароль администратора домена (Administrator).
# Должен соответствовать политике сложности Samba.
DOMAINPASS=ChangeMeNow!2024

# Ordinary AD account used for read-only user/group lookups during refresh.
AD_BIND_PASSWORD=replace-with-a-strong-test-password
AD_TLS_HOSTNAME=dc1.lct.ru

# External cookie path after api-proxy routing.
AUTH_REFRESH_COOKIE_NAME=lct_refresh
AUTH_REFRESH_COOKIE_PATH=/api/app/auth

# IP-адрес Docker-хоста в локальной сети.
# Используется для корректной работы DNS внутри домена.
HOSTIP=172.18.0.3

# DNS-форвардер для внешних запросов (например, 8.8.8.8 или 1.1.1.1)
DNSFORWARDER=127.0.0.11

# Создавать новый домен (false) или присоединиться к существующему (true)
JOIN=false

VITE_YANDEX_MAPS_API_KEY=

# Test event feed virtual clock. The configured journal moment is mapped to
# the moment when test-event-feeder becomes ready.
FEED_SOURCE_START_AT=2026-01-01T00:00:00
FEED_TIME_ZONE=Europe/Moscow
