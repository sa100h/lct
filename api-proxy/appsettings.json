{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "ServiceNamespace": "service-template",
    "OtlpEndpoint": "http://otel-collector:4317",
    "DefaultLogLevel": "Information",
    "FrameworkLogLevel": "Warning",
    "EnableAspNetCoreTracing": true,
    "EnableHttpClientTracing": true,
    "EnableEntityFrameworkCoreTracing": false
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "lct-app-service",
    "Audience": "lct-app-api"
  },
  "ReverseProxy": {
    "Routes": {
      "app-route": {
        "ClusterId": "app-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/app/{**catch-all}" },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      },
      "app-login-route": {
        "ClusterId": "app-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/api/app/auth/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/app" } ]
      },
      "app-refresh-route": {
        "ClusterId": "app-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/api/app/auth/refresh", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/app" } ]
      },
      "app-logout-route": {
        "ClusterId": "app-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/api/app/auth/logout", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/app" } ]
      },
      "app-status-route": {
        "ClusterId": "app-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/api/app/status", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/app" } ]
      },
      "app-ml-status-route": {
        "ClusterId": "app-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/api/app/ml/status", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/app" } ]
      },
      "ml-route": {
        "ClusterId": "ml-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/ml/{**catch-all}" },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    },
    "Clusters": {
      "app-cluster": {
        "Destinations": {
          "app-1": { "Address": "http://app-service:8080/" }
        }
      },
      "ml-cluster": {
        "Destinations": {
          "ml-1": { "Address": "http://ml-service:8000/" }
        }
      }
    }
  }
}

