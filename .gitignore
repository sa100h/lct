# ml-service
ml-service/.venv/
ml-service/models/*
!ml-service/models/.gitkeep
# the four serving artifacts (model.lgb + meta.json) ARE tracked: a clone and the
# image build both need them. Experiment output stays out.
!ml-service/models/sensor-failure
!ml-service/models/sensor-failure/**
!ml-service/models/fire-risk
!ml-service/models/fire-risk/**
!ml-service/models/unauthorized-access
!ml-service/models/unauthorized-access/**
!ml-service/models/infrastructure-wear
!ml-service/models/infrastructure-wear/**
ml-service/models/*/meta.nolags.json
ml-service/models/*/meta.nolags.lgb
ml-service/tests/.pytest_cache/
__pycache__/
*.pyc

# ingested data (organizer exports, local only)
ml-data/*
!ml-data/.gitkeep
# Tracked deliberately despite the rule above (force-added, same as the eight
# agg/agg-<year>.parquet and the reference CSVs): the eight serving files
# features-<cat>.parquet + features-<cat>-latest.parquet, so a clone can train
# and audit the shipped models against the exact data. Everything else under
# ml-data/ stays local: hourly agg, raw 7z/extracted (~15 GB), and experiment
# outputs such as features-fire-risk-enriched.parquet and spatial.parquet.
ext-journal-*.7z
archive-*.zip


#ignore files drawio
docs/diagram/*.bkp

