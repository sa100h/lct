{
  "ConnectionStrings": {
    "AppDb": "Host=localhost;Port=5432;Database=app_db;Username=app_service;Password=app"
  },
  "Migrations": {
    "Path": ""
  },
  "Jwt": {
    "Issuer": "lct-app-service",
    "Audience": "lct-app-api"
  },
  "Ad": {
    "Port": 636,
    "BaseDn": "DC=lct,DC=ru",
    "BindName": "lct-app-bind@lct.ru",
    "TimeoutSeconds": 5
  },
  "RoleAccess": {
    "Roles": [
      {
        "Code": "admin",
        "GroupDn": "CN=Admins,OU=Groups,DC=lct,DC=ru",
        "Permissions": ["demo.access"]
      },
      {
        "Code": "technician",
        "GroupDn": "CN=Technics,OU=Groups,DC=lct,DC=ru",
        "Permissions": ["demo.access"]
      },
      {
        "Code": "dispatcher_ods",
        "GroupDn": "CN=Dispetchers_ODS,OU=Groups,DC=lct,DC=ru",
        "Permissions": ["demo.access"]
      },
      {
        "Code": "dispatcher_district",
        "GroupDn": "CN=Dispetchers_rayon,OU=Groups,DC=lct,DC=ru",
        "Permissions": ["demo.access"]
      }
    ]
  },
  "AuthCookie": {
    "Name": "lct_refresh",
    "Path": "/api/app/auth"
  },
  "Observability": {
    "ServiceNamespace": "service-template",
    "OtlpEndpoint": "http://localhost:4317",
    "DefaultLogLevel": "Information",
    "FrameworkLogLevel": "Warning",
    "EnableAspNetCoreTracing": true,
    "EnableHttpClientTracing": true,
    "EnableEntityFrameworkCoreTracing": false
  },
  "AllowedHosts": "*"
}

